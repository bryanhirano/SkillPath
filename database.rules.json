
{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": false
        },
        "analyses": {
          ".write": false,
          ".indexOn": ["generatedAt"]
        },
        "progress": {
          "$analysisId": {
            ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('analyses').child($analysisId).exists()",
            "$skillId": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            }
          }
        },
        "resumePath": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().beginsWith('resumes/' + $uid + '/')"
        },
        "resumeFileName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "resumeContentType": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === 'application/pdf' || newData.val() === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'"
        },
        "$other": {
          ".write": false
        }
      }
    }
  }
}
