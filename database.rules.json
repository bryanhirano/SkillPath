{
	"rules": {
		".read": false,
		".write": false,
		"users": {
			"$uid": {
				".read": "auth != null && auth.uid === $uid",
				"profile": {
					".write": false
				},
				"analyses": {
					".write": false,
					".indexOn": ["generatedAt"]
				},
				"progress": {
					"$analysisId": {
						".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('analyses').child($analysisId).exists()",
						"$skillId": {
							".validate": "newData.isNumber() && newData.val() <= now"
						}
					}
				},
				"resumePath": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val() === 'resume/' + $uid"				},
				"resumeFileName": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 255"
				},
				"resumeContentType": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.val() === 'application/pdf' || newData.val() === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'"
				},
				"resumeText": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 100000"
				},
				"$other": {
					".write": false
				},
				"name": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 200"
				},
				"email": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 254"
				},
				"color": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 50"
				},
				"phone": {
					".write": "auth != null && auth.uid === $uid",
					".validate": "newData.isString() && newData.val().length <= 30"
				}
			}
		}
	}
}
